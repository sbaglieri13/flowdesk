# Copy this file to .env and fill in the values from your Supabase project.
# Step-by-step guide: docs/supabase-setup.md
# Never commit .env or share it: it contains your database password and service_role key.

# Supabase Dashboard -> Connect -> Session pooler -> URI.
# Replace [YOUR-PASSWORD] with your database password (URL-encode characters such as @ : / ? # %).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase Dashboard -> Project Settings -> API (Data API): Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys: the service_role (secret) key.
SUPABASE_SERVICE_ROLE_KEY=

# Storage buckets created by supabase/02_storage.sql. Change only if you renamed them there.
SUPABASE_ATTACHMENTS_BUCKET=attachments
SUPABASE_BACKUPS_BUCKET=backups

# Port on your computer where Flowdesk is reachable (http://localhost:8000).
FLOWDESK_PUBLISHED_PORT=8000
